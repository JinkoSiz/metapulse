# --- инфраструктура ---
POSTGRES_PASSWORD=metapulse
DATABASE_URL=postgresql+asyncpg://metapulse:metapulse@localhost:5432/metapulse
# порт проброса Redis на хост (внутри compose всегда 6379)
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0
APP_TZ=Europe/Moscow
ADMIN_TOKEN=change-me-before-deploy
LOG_LEVEL=INFO

# домен для Caddy: ":80" локально, "metapulse.example.com" в проде
SITE_ADDRESS=:80

# --- расписание ---
BATCH_SIZE=20
SCHEDULE_CRON_MINUTE=5
CATCH_UP_ON_START=true

# --- Metacritic ---
# apiKey публичный, вшит в HTML сайта; перевыдирается автоматически при 401/403
MC_API_KEY=1MOZgmNFxvmljaQR1X9KAij9Mo4xAY3u
MC_RATE_LIMIT_RPS=2.0
MC_CRITIC_REVIEWS_MAX=40
MC_USER_REVIEWS_MAX=60
# резидентный прокси на случай ужесточения Cloudflare: http://user:pass@host:port
MC_PROXY=

# --- LLM (обязательно для резюме отзывов) ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
LLM_ENABLED=true

# --- эмбеддинги (похожие игры); без ключа работает фолбэк на лексическое сходство ---
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite

# --- YouTube (доп. часть 1) ---
YOUTUBE_API_KEY=
YOUTUBE_ENABLED=true
# резидентный прокси ОБЯЗАТЕЛЕН для транскриптов с датацентрового IP
YOUTUBE_PROXY=

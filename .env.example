# --- инфраструктура ---
POSTGRES_PASSWORD=metapulse
DATABASE_URL=postgresql+asyncpg://metapulse:metapulse@localhost:5432/metapulse
# порт проброса Redis на хост (внутри compose всегда 6379)
REDIS_HOST_PORT=6380
REDIS_URL=redis://localhost:6380/0
APP_TZ=Europe/Moscow
ADMIN_TOKEN=change-me-before-deploy
LOG_LEVEL=INFO

# домен для Caddy: ":80" локально, "metapulse.example.com" в проде.
# На сервере с Nginx Proxy Manager Caddy не нужен — см. docker-compose.server.yml
SITE_ADDRESS=:80

# --- расписание ---
BATCH_SIZE=20
SCHEDULE_CRON_MINUTE=5
CATCH_UP_ON_START=true

# --- Metacritic ---
# apiKey публичный, вшит в HTML сайта; перевыдирается автоматически при 401/403
MC_API_KEY=1MOZgmNFxvmljaQR1X9KAij9Mo4xAY3u
MC_RATE_LIMIT_RPS=2.0
MC_CRITIC_REVIEWS_MAX=40
MC_USER_REVIEWS_MAX=60
# прокси на случай, если Cloudflare ужесточит посадку: http://user:pass@host:port
MC_PROXY=

# --- LLM: ollama (локально, без ключей) или anthropic (облако) ---
LLM_PROVIDER=ollama
LLM_ENABLED=true

# ollama: адрес внутри docker-сети, где живёт контейнер
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b
# На CPU без GPU модель читает промпт ~20 токенов/с, поэтому корпус режется:
# 25 отзывов по 500 символов дают резюме примерно за 4 минуты
OLLAMA_REVIEWS_LIMIT=25
OLLAMA_REVIEW_CHARS=500
OLLAMA_TRANSCRIPT_CHARS=9000

# anthropic: нужен только при LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- эмбеддинги: ollama / voyage / none (лексический фолбэк) ---
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBEDDING_MODEL=bge-m3
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# --- YouTube (доп. часть 1) ---
YOUTUBE_ENABLED=true
# yt-dlp — без ключа и без суточной квоты; official — Data API v3 (нужен ключ)
YOUTUBE_SEARCH_BACKEND=yt-dlp
YOUTUBE_API_KEY=
# HTTP-прокси к YouTube: из России домен напрямую недоступен.
# На сервере с singbox: http://singbox:1081
YOUTUBE_PROXY=
